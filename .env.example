# 환경변수 예시 — 이름만 적는다. 실제 값은 절대 이 파일·코드·GitHub 에 넣지 않는다.
# 로컬: 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 커밋되지 않음).
# 배포: Vercel → Settings → Environment Variables 에 넣는다.
# 셋 다 비워 두면 '시연용 데이터'로 동작한다.

# Supabase → Project Settings → API (또는 Connect) 에서 확인
SUPABASE_URL=
# 공개용 읽기 키(sb_publishable_…). DB 의 RLS 가 읽기만 허용한다.
SUPABASE_PUBLISHABLE_KEY=

# 3단계(수집)부터 사용. 비밀 키(sb_secret_…) — 서버 전용, Vercel 에만 직접 입력. 채팅에 붙여 넣지 말 것.
# NEXT_PUBLIC_ 을 절대 붙이지 않는다.
SUPABASE_SECRET_KEY=
