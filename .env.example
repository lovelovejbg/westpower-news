# 환경변수 예시 — 이름만 적는다. 실제 값은 절대 이 파일·코드·GitHub 에 넣지 않는다.
# 로컬: 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 커밋되지 않음).
# 배포: Vercel → Settings → Environment Variables 에 넣는다.
# SUPABASE_URL · SUPABASE_PUBLISHABLE_KEY 를 비워 두면 '시연용 데이터'로 동작한다.
# 어떤 이름에도 NEXT_PUBLIC_ 을 붙이지 않는다(브라우저에 공개됨).

# ── 읽기 (공개용 값) ──
# Supabase → Connect 또는 Project Settings → API Keys
SUPABASE_URL=
# 공개용 읽기 키(sb_publishable_…). DB 의 RLS 가 읽기만 허용한다.
SUPABASE_PUBLISHABLE_KEY=

# ── 이하 비밀 값: Vercel 에만 직접 입력. 채팅 · 코드 · GitHub 에 넣지 말 것 ──

# Supabase 비밀 키(sb_secret_…). 수집 저장 · 관리자 화면의 수집 기록 조회에 쓴다.
SUPABASE_SECRET_KEY=

# 네이버 클라우드 플랫폼 콘솔 → NAVER API HUB → Application → 인증 정보 (사용 API: 검색 > 뉴스)
# (네이버 개발자센터에서 받은 키는 쓸 수 없음)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# /admin 로그인 비밀번호 (10자 이상)
ADMIN_PASSWORD=
# 로그인 쿠키 서명용 무작위 값 (16자 이상)
ADMIN_SESSION_SECRET=
# 자동 수집 호출 토큰 (16자 이상). Supabase Vault 의 'collect_cron_token' 과 같은 값.
CRON_SECRET=
